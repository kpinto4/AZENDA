# Copia a api/.env y completa los valores (nunca subas .env al repositorio).

# PostgreSQL (Neon u otro)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Firma JWT (obligatorio si NODE_ENV=production)
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# development | production
NODE_ENV=development

# Orígenes del front en producción (separados por coma)
# CORS_ORIGINS=https://azenda.online,https://www.azenda.online

# Puerto HTTP (opcional, default 3000)
# PORT=3000

# Duración del token en segundos (opcional, default 43200 = 12 h)
# JWT_EXPIRES_IN_SEC=43200

# En production: tenant demo y demo-session desactivados salvo que sea true
# AZENDA_DEMO_ENABLED=false

# Ciclo anual en checkout y tenants (v2). Por defecto desactivado.
# AZENDA_ANNUAL_BILLING=true

# Clave inicial del super admin (semilla). Si no se define, usa la del repositorio.
# SUPER_ADMIN_SEED_PASSWORD=

# Correo operativo para avisos de reserva (opcional, hoy solo log)
# BOOKING_NOTIFY_EMAIL=soporte@tudominio.com
